			"name": "User Register",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"hoten\": \"Nguyễn Văn A\",\n    \"sdt\": \"0123456789\",\n    \"diachi\": \"123 Đường ABC, Quận 1, TP.HCM\",\n    \"email\": \"nguyenvana@example.com\",\n    \"ngaysinh\": \"1990-01-01\",\n    \"gioitinh\": \"Nam\",\n    \"matkhau\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/user/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"user",
						"register"
					]
				},
				"description": "Đăng ký tài khoản người dùng mới"
			},
			"response": []
		},
